# ---------------------------------------------------------------
# Carbonix — Apache / LiteSpeed configuration
# Every block is optional and guarded. If your host does not have a
# module, that block is skipped instead of erroring.
# ---------------------------------------------------------------

# Serve the modern image and font formats with the right type. Without
# these an older host returns them as text and the browser discards them,
# which shows up as a site with no images and no fonts.
<IfModule mod_mime.c>
  AddType image/avif             .avif
  AddType image/webp             .webp
  AddType image/svg+xml          .svg
  AddType font/woff              .woff
  AddType font/woff2             .woff2
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json .xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Kept in step with _headers — whichever host is in use, the site gets the
# same policy. Everything the pages load is same-origin since the GSAP, Lenis
# and Google Fonts links were replaced with local copies, so the CSP needs no
# third-party allowances. 'unsafe-inline' is still required: the pages carry
# inline <script> blocks and inline style attributes.
<IfModule mod_headers.c>
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Say it explicitly rather than relying on the host's default. A directory
# with no usable index is the most common cause of a 403 on cPanel: indexes
# are off, so instead of a listing the server refuses the request.
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Things that live in the repo but are not the website.
#
#   _headers / _redirects   the Cloudflare Pages / Netlify half of this same
#                           configuration. Apache ignores them as directives
#                           but serves them as plain text, publishing the CSP
#                           and the whole redirect map to anyone who asks.
#   scripts/                the build and audit tooling.
#   */_source/              image masters and brand vectors.
#
# Denied rather than deleted: they belong in version control, just not on the
# web. _headers and _redirects are matched by name here; the directories are
# handled in the rewrite block below, which is the only place this file turns
# the rewrite engine on.
<FilesMatch "^(_headers|_redirects)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>


<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tooling and source masters: in the repo, not on the web. First rule in the
  # block so nothing below can rewrite its way past it.
  RewriteRule ^(scripts|assets/img/_source|assets/brand/_source)/ - [F,L]

  # A directory must be requested with its trailing slash, otherwise every
  # relative path on the page resolves one level too high.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # /en/systems/index.html -> /en/systems/  (tidy URLs, not required)
  RewriteCond %{THE_REQUEST} \s/(.+/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Cold Brew Kettles was withdrawn from the range
  RewriteRule ^(fa|en|ar)/products/cold-brew-kettles/?$ /$1/products/ [R=301,L]

  # pre-v5 URLs: four "systems" became five products
  RewriteRule ^(fa|en|ar)/systems/(portable|under-counter|multi-outlet)/?$ /$1/products/draft-bar/#$2 [R=301,L,NE]
  RewriteRule ^(fa|en|ar)/systems/custom-island/?$ /$1/products/beverage-island/ [R=301,L]
  RewriteRule ^(fa|en|ar)/systems/?$ /$1/products/ [R=301,L]
</IfModule>
