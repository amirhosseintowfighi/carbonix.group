# ---------------------------------------------------------------
# Carbonix — Apache / LiteSpeed configuration
# Every block is optional and guarded. If your host does not have a
# module, that block is skipped instead of erroring.
# ---------------------------------------------------------------

# Serve the modern image and font formats with the right type. Without
# these an older host returns them as text and the browser discards them,
# which shows up as a site with no images and no fonts.
<IfModule mod_mime.c>
  AddType image/avif             .avif
  AddType image/webp             .webp
  AddType image/svg+xml          .svg
  AddType font/woff              .woff
  AddType font/woff2             .woff2
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json .xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff  "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Kept in step with _headers — whichever host is in use, the site gets the
# same policy. Everything the pages load is same-origin since the GSAP, Lenis
# and Google Fonts links were replaced with local copies, so the CSP needs no
# third-party allowances. 'unsafe-inline' is still required: the pages carry
# inline <script> blocks and inline style attributes.
<IfModule mod_headers.c>
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' mailto:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A directory must be requested with its trailing slash, otherwise every
  # relative path on the page resolves one level too high.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # /en/systems/index.html -> /en/systems/  (tidy URLs, not required)
  RewriteCond %{THE_REQUEST} \s/(.+/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # pre-v5 URLs: four "systems" became five products
  RewriteRule ^(fa|en|ar)/systems/(portable|under-counter|multi-outlet)/?$ /$1/products/draft-bar/#$2 [R=301,L,NE]
  RewriteRule ^(fa|en|ar)/systems/custom-island/?$ /$1/products/beverage-island/ [R=301,L]
  RewriteRule ^(fa|en|ar)/systems/?$ /$1/products/ [R=301,L]
</IfModule>
